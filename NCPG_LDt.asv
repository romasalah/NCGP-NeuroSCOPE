% ==========================================================================
% Overall goal: Compute linear discriminability t-statistic (LDt) per searchlight using shrinkage covariance and cross-validation.
% Place in pipeline: Surface-based MVPA workflow (hyperalignment → GLMs → surface stacks → searchlights → LDt → group stats/corr maps).
% Note: Added comments only; code logic unchanged.
% ==========================================================================
function [ldt_cv_sess, ldt_cv_avg_sess]=NCPG_LDt(wf, betasfn, nbrhoods_idx, nscans_subrun,maskname)
%lDtmatreader=matfile(ldt_fn, 'Writable',true);
%% Calculate LDts for missing ROIs
% Section: for-block starts
for si =1:length(wf.sessions)
% Call → NCPG_paths: Project function call
    p=NCPG_paths(wf);
% Section: for-block starts
    for hi=1:length(wf.hemis)
        curnbrhoods_idx=nbrhoods_idx{si,hi};
        ldt_fn{si,hi}=[p.mp filesep 'LDC' filesep 'group' filesep wf.pre filesep wf.glm filesep 'LDtbyrun_sub-group_' wf.sessions{si}  '_hemi-' wf.hemis{hi} '_mask-' maskname '.mat'];
        fprintf(['\n \n ##################### Session ' num2str(si) ' ###################### \n \n']);
        %% Empty cells
        allroinum=length(curnbrhoods_idx);
        ldt_cv_avg=cell(allroinum, length(wf.hemis));
        ldt_cv=cell(allroinum, length(wf.hemis));
        voxel_indices=curnbrhoods_idx;
        Residuals_curroi=cell(allroinum,1);
        curnscans_subrun=nscans_subrun{si, hi};
        %% Load betas and residuals
        load(betasfn{si,hi});
        runnum= size(betas_condbyrun{1},2);
        cvo=cvpartition(runnum,'LeaveOut');
        trcellbase=cell(length(cvo.TrainSize),1);
        g=[];
        %% Loop Over Missing ROIs
        f = waitbar(0,'Please wait...');
        hbar = parfor_progressbar(allroinum, 'running LDC for all rois')
% Section: for-block starts
betas_condbyrun2=betas_condbyrun;
        parfor mi=1:allroinum
            hbar.iterate(1);
            %% Extracting residuals
            %waitbar(mi/allroinum,f,['Searchlight ' num2str(mi) ' out of ' num2str(allroinum)])
            betas_currroi=permute(betas_condbyrun2{mi}, [1 3 2]);
% Section: for-block starts
            for runi=1:size(curnscans_subrun,1)
                Residuals_curroi{mi}(1:curnscans_subrun{runi,5},:,runi)=allres(curnscans_subrun{runi,4}(1:curnscans_subrun{runi,5}),voxel_indices{mi});
            end
            Faces_LDC{mi,hi}=trcellbase; betasbycond_train=trcellbase; residuals_train=trcellbase; betasbycond_test=trcellbase;
% Section: for-block starts
            for tri=1:length(cvo.TrainSize)
                Faces_LDC{mi,hi}{tri}=[];
                trainruns=training(cvo,tri);
                testruns= test(cvo,tri);
                %% Concatenate training data
                betasbycond_train{tri} = mean(betas_currroi(:,:,trainruns), 3);
                betasbycond_test{tri}= betas_currroi(:,:,testruns);
                residuals_train{tri} = mean(Residuals_curroi{mi}(:,:,trainruns), 3);
% Call → NCPG_LDt_compute: Project function call
                Faces_LDC{mi,hi}{tri}=NCPG_LDt_compute(betasbycond_train{tri}, betasbycond_test{tri}, residuals_train{tri});
            end
% Section: for-block starts
            for runi=1:length(Faces_LDC{mi,hi})
                ldt_cv{mi,hi}(:,:,runi)=Faces_LDC{mi,hi}{runi};
            end
            ldt_cv_avg{mi,hi} = mean(ldt_cv{mi,hi},3);
        end
    delete(f)
    save(ldt_fn{si,hi},'ldt_cv', 'ldt_cv_avg')
    ldt_cv_avg_sess{si}=ldt_cv_avg;
    ldt_cv_sess{si}=ldt_cv;
end
end
end
